<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ProMotion opt-in: without this, iPhone caps custom animations at
	     60 Hz and every entrance reads as half-rate next to 120 Hz system
	     motion. Merged with the generated Info.plist at build time. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
